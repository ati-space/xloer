<Project Sdk="Microsoft.NET.Sdk">

  <!-- Model, WPF drawing engine, image/video export, file conversion and the project library.
       No windows are created here, so everything is testable headless (on an STA thread). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>FastShot.Core</RootNamespace>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
